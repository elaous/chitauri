    "/admin/verified-boot-keys/import/row": {
      "post": {
        "description": "Insert a single verified-boot-key record from a raw CSV body: a\nheader line (`os_id,device,release,verified_boot_key_sha256` \u2014 `os_id`\nmay be dropped if `default_os_id` is given) followed by exactly one\ndata row.",
        "operationId": "import_verified_boot_key_csv_row_admin_verified_boot_keys_import_row_post",
        "parameters": [
          {
            "description": "os_id to use if the row omits the os_id column",
            "in": "query",
            "name": "default_os_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
